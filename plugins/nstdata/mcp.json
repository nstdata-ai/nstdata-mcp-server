{
  "mcpServers": {
    "nstdata": {
      "command": "npx",
      "args": ["--yes", "@nstdata-ai/mcp-server@1.0.3"],
      "env": {
        "NSTDATA_MODULES": "${NSTDATA_MODULES:-crawl}",
        "NSTDATA_API_TOKEN": "${NSTDATA_API_TOKEN:-}",
        "NSTDATA_PROXY_URL": "${NSTDATA_PROXY_URL:-}"
      }
    }
  }
}
