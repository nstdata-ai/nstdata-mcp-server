{
  "mcpServers": {
    "nstdata": {
      "type": "stdio",
      "command": "npx",
      "args": ["--yes", "@nstdata-ai/mcp-server@1.0.3"],
      "env": {
        "NSTDATA_MODULES": "${user_config.NSTDATA_MODULES}",
        "NSTDATA_API_TOKEN": "${user_config.NSTDATA_API_TOKEN}",
        "NSTDATA_PROXY_URL": "${user_config.NSTDATA_PROXY_URL}"
      }
    }
  }
}
